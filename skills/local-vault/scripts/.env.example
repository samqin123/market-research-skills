# ── local-vault 配置：复制本文件为同目录的 .env 再填 ──
# Never commit a real .env / 真实 .env 绝不入库。

# 必填：两个目录（绝对路径，~ 可用）
KB_SOURCE_DIR=~/path/to/raw-files          # 你拖入原始文件（PDF/Office/Excel/图片/md/...）的目录
KB_TARGET_DIR=~/path/to/markdown-vault     # 产出 .md 的 Obsidian / Markdown vault 目录

# 可选：孤儿暂存 + 日志目录（不填用默认）
# KB_ORPHANED_DIR=~/path/to/orphaned
# KB_LOG_DIR=~/path/to/logs

# ── magpie 网关：脚本内所有 LLM 调用（frontmatter 富化 / PPT 图片 OCR）走这里 ──
# 免费优先；地址与模型名全部在此配置，代码不写死。MAGPIE_API_KEY 绝不上传/打印。
MAGPIE_BASE_URL=http://127.0.0.1:3425/v1
MAGPIE_API_KEY=
MAGPIE_MODEL_FAST=group/free-first
MAGPIE_MODEL_MAIN=group/free-first
MAGPIE_MODEL_VISION=group/free-first
MAGPIE_TIMEOUT_SEC=90
MAGPIE_MAX_RETRIES=1

# 成本政策（预估卡 / 超支守卫）
ALLOW_PAID=0
COST_MAX_PER_RUN_CNY=20
COST_MAX_MONTH_CNY=200
# 非交互批量同步需显式确认（TTY 下会问）
# COST_CONFIRM=1
# 非交互 MinerU 云端上传需显式确认（TTY 下会问）
# MINERU_CONFIRM=1

# ── MinerU 官方 API token（可选）──
# 用途：仅扫描版 PDF、老 .doc/.ppt、图片的云端 OCR 兜底；不填也能用全部本地功能，
# 这几类文件会被跳过并在 sync 末尾列明。
# ⚠️ 请先到 https://mineru.net 控制台申请官方 API token，再填到这里。
# 官方现行 key 可能以 sk- 开头（不是 JWT），原样粘贴即可；不要因为解析不出 JWT 就拒绝。
# MINERU_TOKEN=

# 可选：macOS 上默认会往 KB_SOURCE_DIR 放一个可双击的 sync.command（拖文件进去后双击即可同步）。
# 不想让脚本往原始文件目录写这个入口文件，取消注释下一行。
# KB_NO_LAUNCHER=1