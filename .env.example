# ── market-research-skills · shared cost routing / budget config ──
# Copy to .env in the repo root (or the relevant skill's scripts/.env) and fill.
# NEVER commit a real .env; only this example ships.

# magpie gateway (OpenAI-compatible, local). Address/model names come from here — no hard-coding.
MAGPIE_BASE_URL=http://127.0.0.1:3425/v1
# Optional: leave blank when the local gateway needs no key. Never commit a real key.
MAGPIE_API_KEY=
MAGPIE_MODEL_FAST=group/free-first
MAGPIE_MODEL_MAIN=group/free-first
MAGPIE_MODEL_VISION=group/free-first
# Paid tier: only used after an explicit level-3 confirmation.
MAGPIE_MODEL_HEAVY=paid/heavy-review
MAGPIE_TIMEOUT_SEC=90

# Cost policy / 成本政策
ALLOW_PAID=0
COST_MAX_PER_RUN_CNY=20
COST_MAX_MONTH_CNY=200
MRS_COST_LEDGER=.cost-ledger.jsonl

# MinerU official API token (optional; only scanning/legacy-Office/image cloud OCR).
# Apply at https://mineru.net console. Keys may start with sk- (not a JWT). Never commit.
MINERU_TOKEN=